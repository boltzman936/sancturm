# Copy this file to .env.local and fill in real values once you create
# your Supabase project (Connect Supabase milestone). .env.local is
# git-ignored by default — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 — where uploaded PDFs (notes, PYQs, notices, Sancturm
# updates) are stored. Only used server-side (Server Actions), never
# exposed to the browser. See README for how to get these values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public base URL — either the r2.dev dev URL Cloudflare
# gives you, or a custom domain you've connected to the bucket.
R2_PUBLIC_URL=
