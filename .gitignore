# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify CLI state — unrelated to whether netlify.toml exists
.netlify

# Copied from node_modules/pdfjs-dist by the postinstall script (see
# package.json) — always derived from whatever version is installed,
# never hand-edited, so it doesn't belong in source control.
/public/pdf.worker.min.mjs
/public/pdf-cmaps
/public/pdf-standard-fonts

# Per-machine Claude Code tool config ("local" in the name is the
# signal) — accumulates a running allowlist of approved shell commands
# across sessions, including some that read local CLI auth tokens
# (Vercel, Supabase). Values are redacted before being written here,
# but it still has no business in the app's own git history — this was
# committed once by mistake; untracking it going forward.
.claude/settings.local.json
